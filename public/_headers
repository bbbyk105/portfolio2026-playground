# Cloudflare Pages response headers.
#
# Everything under /_next/static is content-hashed by the build, so a given URL
# can never change contents — it is safe to cache for a year and never
# revalidate. HTML is left on the Pages default, which revalidates, so a deploy
# is visible immediately.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# next/og writes the cards as extensionless files, so Pages has no extension
# to type them from and would serve them as application/octet-stream — which
# no social card renderer accepts. The trailing * covers the disambiguating
# suffix Next adds now that each language tree publishes its own copy.
/opengraph-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/twitter-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/apple-icon*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/en/opengraph-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/en/twitter-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/en/apple-icon*
  Content-Type: image/png
  Cache-Control: public, max-age=86400
